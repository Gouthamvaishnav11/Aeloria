pipeline {
    agent any

    environment {
        IMAGE_NAME = 'aeloria-backend'
        CONTAINER_NAME = 'aeloria-container'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', 
                credentialsId: 'github-token',
                url: 'https://github.com/Gouthamvaishnav11/Aeloria.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh 'docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .'
                    sh 'docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_NAME}:latest'
                }
            }
        }

        stage('Run Container') {
            steps {
                script {
                    sh 'docker stop ${CONTAINER_NAME} || true'
                    sh 'docker rm ${CONTAINER_NAME} || true'
                    sh 'docker run -d -p 5000:5000 --name ${CONTAINER_NAME} ${IMAGE_NAME}:latest'
                }
            }
        }

        stage('Test API') {
            steps {
                script {
                    sleep 10  // Wait for container to start
                    sh 'curl -f http://localhost:5000 || echo "Flask API running"'
                }
            }
        }

        stage('Clean Up') {
            steps {
                script {
                    sh 'docker stop ${CONTAINER_NAME} || true'
                    sh 'docker rm ${CONTAINER_NAME} || true'
                    sh 'docker image prune -f'
                }
            }
        }
    }

    post {
        always {
            script {
                // Final cleanup
                sh 'docker stop ${CONTAINER_NAME} || true'
                sh 'docker rm ${CONTAINER_NAME} || true'
            }
            cleanWs()  // Clean workspace
        }
    }
}